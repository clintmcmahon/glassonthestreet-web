@using System.Globalization
@* Server-rendered same-period column chart: no JavaScript, so it also draws for crawlers and print. *@
@model (int[] Years, int[] Counts, string Label)
@{
    const int w = 640, h = 240, left = 48, right = 12, top = 22, bottom = 28;
    var innerW = w - left - right;
    var innerH = h - top - bottom;
    var max = Math.Max(1, Model.Counts.Max());
    var rough = max * 1.08;
    var magnitude = Math.Pow(10, Math.Floor(Math.Log10(rough)));
    var yMax = new[] { 1.0, 2.0, 2.5, 5.0, 10.0 }.Select(s => s * magnitude).First(v => v >= rough);
    string F(double v) => v.ToString("0.#", CultureInfo.InvariantCulture);
    double Y(double v) => top + innerH * (1 - v / yMax);
    var n = Model.Years.Length;
    var slot = innerW / (double)n;
    var barW = Math.Min(28, slot * 0.6);

    // Razor treats a literal <text> tag as its own pseudo-element, so SVG text goes through Html.Raw (the homepage charts do the same).
    string T(double x, double y, string cls, string anchor, string content) =>
        $"<text x=\"{F(x)}\" y=\"{F(y)}\" class=\"{cls}\" text-anchor=\"{anchor}\">{System.Net.WebUtility.HtmlEncode(content)}</text>";
}
<svg viewBox="0 0 @w @h" class="trends-svg" style="width: 100%; height: auto;" role="img" aria-label="@Model.Label">
    @for (var g = 0; g <= 4; g++)
    {
        var gy = Y(yMax / 4 * g);
        <line x1="@left" x2="@(w - right)" y1="@F(gy)" y2="@F(gy)" class="trends-grid" />
        @Html.Raw(T(left - 8, gy + 4, "trends-axis", "end", (yMax / 4 * g).ToString("N0", CultureInfo.InvariantCulture)))
    }
    @for (var i = 0; i < n; i++)
    {
        var cx = left + slot * (i + 0.5);
        var barTop = Y(Model.Counts[i]);
        <rect x="@F(cx - barW / 2)" y="@F(barTop)" width="@F(barW)" height="@F(Math.Max(0, top + innerH - barTop))" rx="3"
              class="trends-bar-fill@(i == n - 1 ? " is-current" : "")" />
        @Html.Raw(T(cx, barTop - 6, "trends-bar-value", "middle", Model.Counts[i].ToString("N0", CultureInfo.InvariantCulture)))
        @Html.Raw(T(cx, h - 8, "trends-axis", "middle", Model.Years[i].ToString(CultureInfo.InvariantCulture)))
    }
</svg>
