@using GlassOnTheStreet.Web.Models
@using GlassOnTheStreet.Web.Controllers.Admin
@model AdminIndexViewModel
@{
    ViewData["Title"] = "Admin";
    ViewData["NoIndex"] = true;
    Layout = "_Layout";
}

<div class="page">
    <p class="kicker">Admin</p>
    <h1 style="font-size: 1.7rem;">Reports</h1>
    <p class="field-hint">
        @(Model.MpdLastSyncedAt is { } lastSyncedAt
            ? $"MPD data last synced {lastSyncedAt.FormatSyncTimestamp()}."
            : "MPD data has not synced yet.")
    </p>

    @{ var status = Model.DataStatus; }
    <details class="admin-data-status" open>
        <summary>Data status</summary>
        <p class="field-hint">
            @status.MpdTotal.Format() MPD rows@(status.Earliest is { } first && status.Latest is { } last ? $", report dates {first:yyyy-MM-dd} to {last:yyyy-MM-dd}" : "").
            Import running: <strong>@(Model.ImportRunning ? "yes" : "no")</strong>.
            During an import these counts grow as pages load. <a href="/admin">Refresh</a>
        </p>
        <div class="admin-data-grid">
            <table class="admin-table">
                <thead><tr><th>Year</th><th>Car categories (map)</th><th>All offenses (crime stats)</th></tr></thead>
                <tbody>
                    @{
                        var carByYear = status.MpdRowsByYear.ToDictionary(r => r.Year, r => r.Count);
                        var allByYear = status.IncidentRowsByYear.ToDictionary(r => r.Year, r => r.Count);
                    }
                    @foreach (var year in carByYear.Keys.Union(allByYear.Keys).OrderBy(y => y))
                    {
                        <tr>
                            <td>@year</td>
                            <td>@(carByYear.TryGetValue(year, out var carCount) ? carCount.Format() : "0")</td>
                            <td>@(allByYear.TryGetValue(year, out var allCount) ? allCount.Format() : "0")</td>
                        </tr>
                    }
                    <tr><td><strong>Total</strong></td><td><strong>@status.MpdTotal.Format()</strong></td><td><strong>@status.IncidentTotal.Format()</strong></td></tr>
                </tbody>
            </table>
            <table class="admin-table">
                <thead><tr><th>One-time startup task</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var task in status.Tasks)
                    {
                        <tr>
                            <td>@task.Description<br /><span class="field-hint">@task.Key</span></td>
                            <td>@(task.CoveredBy is not null ? "Done (covered by an earlier import)" : task.CompletedAt is { } done ? $"Done {done.FormatSyncTimestamp()}" : "Not run yet")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="field-hint">
            A task that stays "Not run yet" after a deploy is waiting on the next startup or on a running import.
            Imports are loaded one year at a time and are safe to interrupt: a restart (including a deploy) repeats only the year that was running.
        </p>
    </details>

    @if (Model.ImportRunning)
    {
        <p class="field-hint" style="border: 1px solid var(--accent); color: var(--accent); padding: 0.6rem 0.9rem; margin: 1rem 0;">
            An MPD import is currently running in the background (automatic -- daily sync or startup reimport). Refresh this page to check progress.
        </p>
    }

    <h2 style="font-size: 1.15rem; margin-top: 2.5rem;">Pending review (@Model.Pending.Count.Format())</h2>
    @if (Model.Pending.Count == 0)
    {
        <p class="field-hint">Nothing waiting on review.</p>
    }
    else
    {
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Location (snapped)</th>
                    <th>Cross streets</th>
                    <th>Submitted</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var report in Model.Pending)
            {
                <tr>
                    <td>@report.ReportedDate.ToString("yyyy-MM-dd")</td>
                    <td>@(report.IncidentType == IncidentType.WindowSmashed ? "Window smashed" : "Rifled")</td>
                    <td>@report.DisplayLat.ToString("0.0000"), @report.DisplayLng.ToString("0.0000")</td>
                    <td>@(report.CrossStreets ?? "—")</td>
                    <td>@report.CreatedAt.FormatDateTime()</td>
                    <td style="white-space: nowrap;">
                        <form asp-controller="Admin" asp-action="Approve" asp-route-id="@report.Id" method="post" style="display:inline;">
                            <button type="submit" class="btn-toggle">Approve</button>
                        </form>
                        <form asp-controller="Admin" asp-action="Delete" asp-route-id="@report.Id" method="post" style="display:inline;">
                            <button type="submit" class="btn-toggle">Reject</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }

    <div style="display: flex; align-items: baseline; justify-content: space-between; margin-top: 2.5rem; flex-wrap: wrap; gap: 0.5rem;">
        <h2 style="font-size: 1.15rem; margin: 0;">All reports (@Model.TotalRecent.Format())</h2>
        <span class="field-hint">Page @Model.Page.Format() of @Model.TotalPages.Format()</span>
    </div>
    <table class="admin-table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Type</th>
                <th>Source</th>
                <th>Location (snapped)</th>
                <th>Status</th>
                <th>Flags</th>
                <th>Submitted</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var report in Model.Recent)
        {
            <tr>
                <td>@report.ReportedDate.ToString("yyyy-MM-dd")</td>
                <td>
                    @(report.SourceType == SourceType.OfficialImport
                        ? report.Offense
                        : report.IncidentType == IncidentType.WindowSmashed ? "Window smashed" : "Rifled")
                </td>
                <td>@(report.SourceType == SourceType.OfficialImport ? "MPD import" : "Resident")</td>
                <td>@report.DisplayLat.ToString("0.0000"), @report.DisplayLng.ToString("0.0000")</td>
                <td>
                    @if (report.Status == ReportStatus.Flagged)
                    {
                        <span class="tag flagged">Flagged</span>
                    }
                    else if (report.Status == ReportStatus.Removed)
                    {
                        <span class="tag removed">Removed</span>
                    }
                    else
                    {
                        <span class="tag">Active</span>
                    }
                </td>
                <td>@report.Flags.Count</td>
                <td>@report.CreatedAt.FormatDateTime()</td>
                <td>
                    @if (report.Status != ReportStatus.Removed)
                    {
                        <form asp-controller="Admin" asp-action="Delete" asp-route-id="@report.Id" method="post" style="display:inline;">
                            <button type="submit" class="btn-toggle">Remove</button>
                        </form>
                    }
                    else
                    {
                        <form asp-controller="Admin" asp-action="Restore" asp-route-id="@report.Id" method="post" style="display:inline;">
                            <button type="submit" class="btn-toggle">Restore</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>

    <div style="display: flex; justify-content: space-between; align-items: center; margin: 1.25rem 0;">
        @if (Model.Page > 1)
        {
            <a class="btn btn-outline" asp-controller="Admin" asp-action="Index" asp-route-page="@(Model.Page - 1)">&larr; Newer</a>
        }
        else
        {
            <span></span>
        }
        @if (Model.Page < Model.TotalPages)
        {
            <a class="btn btn-outline" asp-controller="Admin" asp-action="Index" asp-route-page="@(Model.Page + 1)">Older &rarr;</a>
        }
    </div>
</div>
