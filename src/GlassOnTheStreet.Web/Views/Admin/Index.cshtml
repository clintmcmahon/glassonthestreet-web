@using GlassOnTheStreet.Web.Models
@using GlassOnTheStreet.Web.Controllers.Admin
@model AdminIndexViewModel
@{
    ViewData["Title"] = "Admin";
    Layout = "_Layout";
}

<div class="page">
    <p class="kicker">Admin</p>
    <h1 style="font-size: 1.7rem;">Reports</h1>

    @if (Model.ImportRunning)
    {
        <p class="field-hint" style="border: 1px solid var(--accent); color: var(--accent); padding: 0.6rem 0.9rem; margin: 1rem 0;">
            An MPD import is currently running in the background (automatic -- daily sync or startup reimport). Refresh this page to check progress.
        </p>
    }

    <h2 style="font-size: 1.15rem; margin-top: 2.5rem;">Pending review (@Model.Pending.Count)</h2>
    @if (Model.Pending.Count == 0)
    {
        <p class="field-hint">Nothing waiting on review.</p>
    }
    else
    {
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Location (snapped)</th>
                    <th>Cross streets</th>
                    <th>Submitted</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var report in Model.Pending)
            {
                <tr>
                    <td>@report.ReportedDate.ToString("yyyy-MM-dd")</td>
                    <td>@(report.IncidentType == IncidentType.WindowSmashed ? "Window smashed" : "Rifled")</td>
                    <td>@report.DisplayLat.ToString("0.0000"), @report.DisplayLng.ToString("0.0000")</td>
                    <td>@(report.CrossStreets ?? "—")</td>
                    <td>@report.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td style="white-space: nowrap;">
                        <form asp-controller="Admin" asp-action="Approve" asp-route-id="@report.Id" method="post" style="display:inline;">
                            <button type="submit" class="btn-toggle">Approve</button>
                        </form>
                        <form asp-controller="Admin" asp-action="Delete" asp-route-id="@report.Id" method="post" style="display:inline;">
                            <button type="submit" class="btn-toggle">Reject</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }

    <h2 style="font-size: 1.15rem; margin-top: 2.5rem;">All reports</h2>
    <table class="admin-table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Type</th>
                <th>Source</th>
                <th>Location (snapped)</th>
                <th>Status</th>
                <th>Flags</th>
                <th>Submitted</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var report in Model.Recent)
        {
            <tr>
                <td>@report.ReportedDate.ToString("yyyy-MM-dd")</td>
                <td>
                    @(report.SourceType == SourceType.OfficialImport
                        ? report.Offense
                        : report.IncidentType == IncidentType.WindowSmashed ? "Window smashed" : "Rifled")
                </td>
                <td>@(report.SourceType == SourceType.OfficialImport ? "MPD import" : "Resident")</td>
                <td>@report.DisplayLat.ToString("0.0000"), @report.DisplayLng.ToString("0.0000")</td>
                <td>
                    @if (report.Status == ReportStatus.Flagged)
                    {
                        <span class="tag flagged">Flagged</span>
                    }
                    else if (report.Status == ReportStatus.Removed)
                    {
                        <span class="tag removed">Removed</span>
                    }
                    else
                    {
                        <span class="tag">Active</span>
                    }
                </td>
                <td>@report.Flags.Count</td>
                <td>@report.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td>
                    @if (report.Status != ReportStatus.Removed)
                    {
                        <form asp-controller="Admin" asp-action="Delete" asp-route-id="@report.Id" method="post" style="display:inline;">
                            <button type="submit" class="btn-toggle">Remove</button>
                        </form>
                    }
                    else
                    {
                        <form asp-controller="Admin" asp-action="Restore" asp-route-id="@report.Id" method="post" style="display:inline;">
                            <button type="submit" class="btn-toggle">Restore</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
