@model GlassOnTheStreet.Web.Controllers.MapPageViewModel
@{
    ViewData["Title"] = "The Map";
    var stats = Model.Stats;
    var changeText = stats.PercentChange is null
        ? "—"
        : $"{(stats.PercentChange > 0 ? "+" : "")}{stats.PercentChange}%";
    var changeClass = stats.PercentChange is > 0 ? "up" : stats.PercentChange is < 0 ? "down" : "";
    ViewData["Description"] =
        "An interactive map of car break-ins across Minneapolis, combining resident reports with Minneapolis Police Department data, filterable by date. " +
        $"{stats.Count} reports in the last 30 days" +
        (stats.PercentChange is null ? "." : $", {changeText} versus the prior 30 days.");

    var timeOfDayOrder = new[] { "Overnight", "Morning", "Afternoon", "Evening", "NotSure" };
    var timeOfDayLabel = new Dictionary<string, string>
    {
        ["Overnight"] = "Overnight", ["Morning"] = "Morning", ["Afternoon"] = "Afternoon",
        ["Evening"] = "Evening", ["NotSure"] = "Not sure"
    };
    var maxNeighborhood = Model.Breakdown.TopNeighborhoods.Count > 0 ? Model.Breakdown.TopNeighborhoods.Max(n => n.Count) : 1;
    var timeOfDayByBucket = Model.Breakdown.TimeOfDay.ToDictionary(t => t.Bucket, t => t.Count);
    var maxTimeOfDay = timeOfDayByBucket.Count > 0 ? timeOfDayByBucket.Values.Max() : 1;
}

@section Head {
    <link href="https://cdn.jsdelivr.net/npm/maplibre-gl@4/dist/maplibre-gl.css" rel="stylesheet" />
}

@section StructuredData {
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "Dataset",
        "name": "Glass on the Street — Minneapolis car break-in reports",
        "description": "Resident-submitted car break-in reports for Minneapolis, Minnesota, combined with Minneapolis Police Department theft-from-vehicle and vandalism records. Locations are snapped to the block level for privacy.",
        "spatialCoverage": {
            "@@type": "Place",
            "name": "Minneapolis, Minnesota"
        },
        "creator": {
            "@@type": "Organization",
            "name": "Glass on the Street"
        },
        "distribution": {
            "@@type": "DataDownload",
            "encodingFormat": "application/geo+json",
            "contentUrl": "/api/reports"
        }
    }
    </script>
}

<div class="page" style="padding-bottom: 1.5rem;">
    <p class="kicker">The map</p>
    <h1 style="font-size: 1.9rem;">Where break-ins are being reported</h1>

    <div class="stat-line" id="stat-line">
        <div class="stat">
            <div class="stat-value" id="stat-count">@stats.Count</div>
            <div class="stat-label" id="stat-count-label">reports, last 30 days</div>
        </div>
        <div class="stat">
            <div class="stat-value @changeClass" id="stat-change">@changeText</div>
            <div class="stat-label">vs. the prior period</div>
        </div>
    </div>
</div>

<div class="breakout map-section">
    <div class="map-toolbar">
        <div class="date-presets" id="date-presets">
            <button class="tab-toggle" data-days="7">7 days</button>
            <button class="tab-toggle active" data-days="30">30 days</button>
            <button class="tab-toggle" data-days="90">90 days</button>
            <button class="tab-toggle" data-days="all">All time</button>
            <input type="date" id="from-date" aria-label="From date" style="width: auto; display: none;" />
            <input type="date" id="to-date" aria-label="To date" style="width: auto; display: none;" />
        </div>
        <div class="date-presets">
            <button class="tab-toggle active" id="mode-pins">Pins</button>
            <button class="tab-toggle" id="mode-heat">Heatmap</button>
        </div>
    </div>

    <div class="map-frame">
        <div id="map"></div>
    </div>
</div>

<div class="page" style="padding-top: 1.25rem;">
    <div class="map-legend">
        <span><span class="legend-dot window"></span>Window smashed</span>
        <span><span class="legend-dot rifled"></span>Rifled through (unlocked)</span>
        <span><span class="legend-dot unknown"></span>MPD record</span>
    </div>

    <div class="breakdown-grid">
        <div>
            <h2 class="breakdown-heading">Where</h2>
            <div id="breakdown-neighborhoods">
                @if (Model.Breakdown.TopNeighborhoods.Count == 0)
                {
                    <p class="field-hint">Not enough data with a known neighborhood yet.</p>
                }
                else
                {
                    @foreach (var n in Model.Breakdown.TopNeighborhoods)
                    {
                        <div class="breakdown-row">
                            <span class="breakdown-label">@n.Name</span>
                            <span class="breakdown-bar-track"><span class="breakdown-bar" style="width:@((n.Count * 100.0 / maxNeighborhood).ToString("0.##"))%"></span></span>
                            <span class="breakdown-count">@n.Count</span>
                        </div>
                    }
                }
            </div>
        </div>
        <div>
            <h2 class="breakdown-heading">When</h2>
            <div id="breakdown-time-of-day">
                @if (timeOfDayByBucket.Count == 0)
                {
                    <p class="field-hint">Not enough data with a known time of day yet.</p>
                }
                else
                {
                    @foreach (var bucket in timeOfDayOrder.Where(b => timeOfDayByBucket.ContainsKey(b)))
                    {
                        <div class="breakdown-row">
                            <span class="breakdown-label">@timeOfDayLabel[bucket]</span>
                            <span class="breakdown-bar-track"><span class="breakdown-bar" style="width:@((timeOfDayByBucket[bucket] * 100.0 / maxTimeOfDay).ToString("0.##"))%"></span></span>
                            <span class="breakdown-count">@timeOfDayByBucket[bucket]</span>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/maplibre-gl@4/dist/maplibre-gl.js"></script>
    <script src="~/js/map-theme.js" asp-append-version="true"></script>
    <script src="~/js/map.js" asp-append-version="true"></script>
}
