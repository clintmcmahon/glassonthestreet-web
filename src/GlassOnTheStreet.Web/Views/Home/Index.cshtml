@model GlassOnTheStreet.Web.Controllers.HomePageViewModel
@{
    ViewData["Title"] = "Glass on the Street — Minneapolis Car Break-In Map";
    var stats = Model.Stats;
    var gap = Model.ReportingGap;
    var changeText = stats.PercentChange is null
        ? "—"
        : $"{(stats.PercentChange > 0 ? "+" : "")}{stats.PercentChange}%";
    var changeClass = stats.PercentChange is > 0 ? "up" : stats.PercentChange is < 0 ? "down" : "";
    ViewData["Description"] =
        "Report car break-ins in Minneapolis — smashed windows and cars rifled through. " +
        "Enough reports and we can show police and city hall where and when it's happening. " +
        $"{stats.Count} reports in the last 30 days" +
        (stats.PercentChange is null ? "." : $", {changeText} versus the prior 30 days.");

    var maxTrend = Model.Trend.Count > 0 ? Math.Max(1, Model.Trend.Max(t => t.Count)) : 1;

    var categoryOrder = new[] { "WindowSmashed", "Rifled", "Unknown", "PartsTheft", "VehicleStolen" };
    var categoryLabel = new Dictionary<string, string>
    {
        ["WindowSmashed"] = "Window smashed",
        ["Rifled"] = "Rifled through",
        ["Unknown"] = "MPD record (break-in)",
        ["PartsTheft"] = "Parts/accessories stolen (MPD)",
        ["VehicleStolen"] = "Vehicle stolen (MPD)"
    };
    var categoryCssClass = new Dictionary<string, string>
    {
        ["WindowSmashed"] = "cat-window",
        ["Rifled"] = "cat-rifled",
        ["Unknown"] = "cat-unknown",
        ["PartsTheft"] = "cat-parts",
        ["VehicleStolen"] = "cat-stolen"
    };
    var categoryByKey = Model.Categories.ToDictionary(c => c.Category, c => c.Count);
    var maxCategory = categoryByKey.Count > 0 ? Math.Max(1, categoryByKey.Values.Max()) : 1;
}

@section Head {
    <link href="https://cdn.jsdelivr.net/npm/maplibre-gl@4/dist/maplibre-gl.css" rel="stylesheet" />
}

<div class="page">
    <p class="kicker">Minneapolis</p>
    <h1 class="display" style="font-size: 2.6rem; max-width: 720px;">
        We track smashed windows and rifled-through cars to report to city hall.
    </h1>
    <p class="lede">
        Report a car break-in in under a minute. Enough reports and we can
        show exactly where and when this is happening, hotspots and then take that to
        the police and city hall.
    </p>

    <div class="stat-line">
        <div class="stat">
            <div class="stat-value">@stats.Count</div>
            <div class="stat-label">reports, last 30 days</div>
        </div>
        <div class="stat">
            <div class="stat-value @changeClass">@changeText</div>
            <div class="stat-label">vs. the 30 days before that</div>
        </div>
        @if (gap.PercentUnreported is not null)
        {
            <div class="stat">
                <div class="stat-value up">@(gap.PercentUnreported)%</div>
                <div class="stat-label">of reporters never told police</div>
            </div>
        }
    </div>

    <p>
        <a class="btn" asp-controller="Report" asp-action="Index">Report a break-in</a>
        &nbsp;
        <a class="btn btn-outline" asp-controller="Map" asp-action="Index">View the map</a>
    </p>

    <div class="map-frame map-frame-preview">
        <a class="map-frame-link" asp-controller="Map" asp-action="Index" aria-label="Open the full interactive map"></a>
        <div id="home-map"></div>
    </div>
    <div class="map-preview-caption">
        <span>Every dot is a real report. Click the map to explore it.</span>
        <a asp-controller="Map" asp-action="Index">Open the full map &rarr;</a>
    </div>

    <div class="graphs-grid">
        <div>
            <h2 class="graph-heading">Reports by month</h2>
            @if (Model.Trend.Count == 0)
            {
                <p class="field-hint">Not enough data yet.</p>
            }
            else
            {
                <div class="trend-chart" role="img" aria-label="Reports per month for the last six months">
                    @foreach (var m in Model.Trend)
                    {
                        <div class="trend-bar-col">
                            <div class="trend-bar-track">
                                <div class="trend-bar" style="height:@((m.Count * 100.0 / maxTrend).ToString("0.##"))%"></div>
                            </div>
                            <div class="trend-bar-count">@m.Count</div>
                            <div class="trend-bar-label">@m.MonthLabel</div>
                        </div>
                    }
                </div>
            }
        </div>
        <div>
            <h2 class="graph-heading">What's on the map</h2>
            @if (categoryByKey.Count == 0)
            {
                <p class="field-hint">Not enough data yet.</p>
            }
            else
            {
                <div class="category-list">
                    @foreach (var key in categoryOrder.Where(k => categoryByKey.ContainsKey(k)))
                    {
                        <div class="breakdown-row">
                            <span class="breakdown-label">@categoryLabel[key]</span>
                            <span class="breakdown-bar-track"><span class="breakdown-bar @categoryCssClass[key]" style="width:@((categoryByKey[key] * 100.0 / maxCategory).ToString("0.##"))%"></span></span>
                            <span class="breakdown-count">@categoryByKey[key]</span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <h2 style="margin-top: 3rem; font-size: 1.4rem;">Why this exists</h2>
    <p>
        Police don't track this the way we need them to. Their data has a
        category for a car getting broken into, "Theft From Motor
        Vehicle," but it doesn't say how someone got in -- a smashed
        window and someone rifling through your glovebox get lumped into
        the same record. There's no field for what actually happened.
    </p>
    <p>
        Most people don't report it either. When a window gets smashed and nothing is missing what are the police going to
        do about it? A police report is never created and neither is that data point. Multiply that by every car on
        your block and there's no record of any of it anywhere.
    </p>
    <p>
        This site fixes both problems. Report a window getting smashed
        or a car getting rifled through, block by block, date by date.
        Right now the map is mostly MPD's own numbers -- car break-ins,
        parts theft, and full vehicle theft -- since that's what exists
        until enough of you report your own. After a while we can go to
        police and city hall with specifics about what's going on: which
        blocks, which times, how often.
    </p>

    <h2 style="margin-top: 2.5rem; font-size: 1.4rem;">Your privacy</h2>
    <p>
        Locations shown on the map are snapped to the block and never the exact
        address. This is how the MPD saves their data and so do we. It's all in the name of privacy.
        After you submit a report we also point you to
        Minneapolis Police Department's online reporting, since this site is
        meant to complement official channels, not replace them.
    </p>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/maplibre-gl@4/dist/maplibre-gl.js"></script>
    <script src="~/js/map-theme.js" asp-append-version="true"></script>
    <script src="~/js/home-map.js" asp-append-version="true"></script>
}
