@using GlassOnTheStreet.Web.Services
@inject IConfiguration Configuration
@model GlassOnTheStreet.Web.Controllers.HomePageViewModel
@{
    ViewData["Title"] = "Minneapolis Crime Statistics and Car Break-In Map | Glass on the Street";
    ViewData["OgImage"] = "/og/trends.png";
    var stats = Model.Stats;
    var gap = Model.ReportingGap;
    var changeText = stats.PercentChange is null
        ? "—"
        : $"{(stats.PercentChange > 0 ? "+" : "")}{stats.PercentChange}%";
    var changeClass = stats.PercentChange is > 0 ? "up" : stats.PercentChange is < 0 ? "down" : "";
    ViewData["Description"] =
        $"Minneapolis crime statistics for every offense type, 2019 to today, plus a car break-in map. {stats.Count.Format()} car-related offenses in the last 30 days. " +
        "Neighborhood and ward data from MPD.";

    // Year to date vs the same window of earlier years (Jan 1 through the
    // last date MPD's records are mostly complete), the same numbers /trends leads with.
    var ytd = Model.Trends;
    var ytdNow = ytd.SamePeriod[^1];
    var ytdPrior = ytd.SamePeriod[^2];
    var ytdBase = ytd.SamePeriod[0];
    string Pct(int now, int then) =>
        then == 0 ? "n/a" : $"{(now >= then ? "+" : "-")}{Math.Abs(Math.Round((now - then) / (double)then * 100)).ToString("0", System.Globalization.CultureInfo.InvariantCulture)}%";
    string PctClass(int now, int then) => then == 0 ? "" : now > then ? "up" : now < then ? "down" : "";
    var crime = Model.Crime;
    var crimeNow = crime.SamePeriod[^1];
    var crimePrior = crime.SamePeriod[^2];
    var crimeBase = crime.SamePeriod[0];
    var crimeGroups = crime.Groups.Where(g => g.IsCrime).OrderByDescending(g => g.Counts[^1]).Take(8).ToList();
    var maxGroup = crimeGroups.Count > 0 ? Math.Max(1, crimeGroups.Max(g => g.Counts[^1])) : 1;
    string Chg(double? c) => c is { } v ? $"{(v >= 0 ? "+" : "-")}{Math.Abs(Math.Round(v)).ToString("0", System.Globalization.CultureInfo.InvariantCulture)}%" : "";
    var ytdThrough = ytd.Through.ToString("MMM d", System.Globalization.CultureInfo.InvariantCulture);

    // The preview uses Mapbox like /map does when a token is configured. Mapbox:HomePreview = false keeps
    // this page on the free open-source map, since every page view that reaches the map is a billed map load.
    var mapboxToken = Configuration["Mapbox:AccessToken"];
    var useMapbox = !string.IsNullOrWhiteSpace(mapboxToken) && !string.Equals(Configuration["Mapbox:HomePreview"], "false", StringComparison.OrdinalIgnoreCase);
    var mapboxStyle = Configuration["Mapbox:StyleUrl"] is { Length: > 0 } customStyle ? customStyle : "mapbox://styles/mapbox/light-v11";
    var mapConfig = System.Text.Json.JsonSerializer.Serialize(new { engine = useMapbox ? "mapbox" : "maplibre", token = useMapbox ? mapboxToken : null, style = useMapbox ? mapboxStyle : null });

    var maxTrend = Model.Trend.Count > 0 ? Math.Max(1, Model.Trend.Max(t => t.Count)) : 1;

    var categoryOrder = new[] { "Unknown", "PartsTheft", "VehicleStolen", "PropertyDamage", "WindowSmashed", "Rifled" };
    var categoryLabel = new Dictionary<string, string>
    {
        ["WindowSmashed"] = "Window smashed",
        ["Rifled"] = "Rifled through",
        ["Unknown"] = "Theft From Motor Vehicle (MPD)",
        ["PartsTheft"] = "Theft of Motor Vehicle Parts/Accessories (MPD)",
        ["VehicleStolen"] = "Motor Vehicle Theft (MPD)",
        ["PropertyDamage"] = "Destruction/Damage/Vandalism of Property (MPD)"
    };
    var categoryCssClass = new Dictionary<string, string>
    {
        ["WindowSmashed"] = "cat-window",
        ["Rifled"] = "cat-rifled",
        ["Unknown"] = "cat-unknown",
        ["PartsTheft"] = "cat-parts",
        ["PropertyDamage"] = "cat-damage",
        ["VehicleStolen"] = "cat-stolen"
    };
    var categoryByKey = Model.Categories.ToDictionary(c => c.Category, c => c.Count);
    var maxCategory = categoryByKey.Count > 0 ? Math.Max(1, categoryByKey.Values.Max()) : 1;

    // "How these categories have trended" charts -- our own imported MPD
    // data (Model.TheftFromVehicleTrend etc., computed server-side by
    // HomeController/ReportStatsService), not a third-party source. Only
    // Minneapolis: MPD's open data doesn't cover other cities, so there's
    // no peer-city comparison here, just our own numbers over time.
    var yearlyCharts = new[]
    {
        (Title: "Theft from motor vehicle", Slug: "theft-from-vehicle", Counts: Model.TheftFromVehicleTrend),
        (Title: "Destruction/damage/vandalism of property", Slug: "property-damage", Counts: Model.PropertyDamageTrend),
        (Title: "Motor vehicle theft", Slug: "vehicle-theft", Counts: Model.VehicleTheftTrend)
    };

    // Compact geometry: three charts sit side by side on desktop, so the
    // viewBox is close to the rendered width and labels stay legible.
    const int chartW = 360, chartH = 200;
    const int marginLeft = 42, marginRight = 54, marginTop = 14, marginBottom = 28;

    int NiceMax(int actualMax)
    {
        if (actualMax <= 0) return 10;
        var rough = actualMax * 1.15;
        var magnitude = Math.Pow(10, Math.Floor(Math.Log10(rough)));
        foreach (var step in new[] { 1.0, 2.0, 5.0, 10.0 })
        {
            var candidate = step * magnitude;
            if (candidate >= rough) return (int)candidate;
        }
        return (int)(10 * magnitude);
    }

    string F(double v) => v.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    double PlotX(int pointCount, int index) =>
        marginLeft + ((chartW - marginLeft - marginRight) * index / (double)(pointCount - 1));

    double PlotY(int value, int yMax) =>
        marginTop + (chartH - marginTop - marginBottom) - ((chartH - marginTop - marginBottom) * value / (double)yMax);
}

@section Head {
    @if (useMapbox)
    {
        <link href="https://api.mapbox.com/mapbox-gl-js/v3.13.0/mapbox-gl.css" rel="stylesheet" />
    }
    else
    {
        <link href="https://cdn.jsdelivr.net/npm/maplibre-gl@4/dist/maplibre-gl.css" rel="stylesheet" />
    }
}

<div class="page">
    <p class="kicker">Minneapolis</p>
    <h1 class="display" style="font-size: 2.6rem; max-width: 720px;">
        Minneapolis crime data: every offense the police record, plus a closer look at car break-ins.
    </h1>
    <p class="lede">
        This site has two parts. <strong>Part 1</strong> is a crime database for the whole city: every offense type
        Minneapolis police (MPD) record, by neighborhood and ward, 2019 to today. <strong>Part 2</strong> is
        about car crime only: the same MPD data for cars, plus a map where residents report break-ins that never reach the police.
    </p>
    <p class="part-nav">
        <a class="btn btn-outline" href="#all-crime">Part 1: All crime</a>
        <a class="btn btn-outline" href="#car-crime">Part 2: Car crime</a>
    </p>

    <section id="all-crime" class="home-part">
    <h2 class="part-heading">Part 1: All crime in Minneapolis <span>(MPD data, every offense type)</span></h2>
    <p class="scope-note">
        <strong>What this part counts:</strong> every crime MPD records, from homicide and assault to burglary, theft and vandalism.
        Car crime is included here as part of the total, and broken out in Part 2.
        Shots-fired calls and gunshot victims are not crimes in MPD's data and are left out.
        Resident reports are never part of these numbers.
        <a href="#what-these-numbers-mean">Full definitions</a>
    </p>
    <div class="stat-line stat-line-year">
        <div class="stat">
            <div class="stat-value">@crimeNow.Format()</div>
            <div class="stat-label">offenses of all types recorded by MPD, Jan 1 to @ytdThrough @crime.CurrentYear</div>
        </div>
        <div class="stat">
            <div class="stat-value @PctClass(crimeNow, crimePrior)">@Pct(crimeNow, crimePrior)</div>
            <div class="stat-label">change in all offenses vs. Jan 1 to @ytdThrough @(crime.CurrentYear - 1)</div>
        </div>
        <div class="stat">
            <div class="stat-value @PctClass(crimeNow, crimeBase)">@Pct(crimeNow, crimeBase)</div>
            <div class="stat-label">change in all offenses vs. Jan 1 to @ytdThrough @crime.Years[0], the last year before COVID</div>
        </div>
    </div>
    <h3 class="graph-heading" style="margin-top: 1.5rem;">Most common offense types in @crime.CurrentYear (MPD data)</h3>
    <p class="field-hint">Offenses recorded Jan 1 to @ytdThrough, with the change from the same dates in @(crime.CurrentYear - 1). Car-related types are in this list too.</p>
    <div class="category-list">
        @foreach (var g in crimeGroups)
        {
            <div class="breakdown-row">
                <span class="breakdown-label">@g.Label <span class="home-area-change @(g.ChangeVsPrior is > 0 ? "up" : g.ChangeVsPrior is < 0 ? "down" : "")">@Chg(g.ChangeVsPrior)</span></span>
                <span class="breakdown-bar-track"><span class="breakdown-bar cat-unknown" style="width:@((g.Counts[^1] * 100.0 / maxGroup).ToString("0.##"))%"></span></span>
                <span class="breakdown-count">@g.Counts[^1].Format()</span>
            </div>
        }
    </div>
    <p style="margin-top: 1.25rem;">
        <a class="btn" asp-controller="Crime" asp-action="Index">All crime statistics</a>
        &nbsp;
        <a class="btn btn-outline" asp-controller="Near" asp-action="Index">Crime near you</a>
        &nbsp;
        <a class="btn btn-outline" asp-controller="Areas" asp-action="Index">By neighborhood and ward</a>
    </p>
    </section>

    <section id="car-crime" class="home-part">
    <h2 class="part-heading">Part 2: Car crime <span>(a subset of Part 1, plus resident reports)</span></h2>
    <p class="scope-note">
        <strong>What this part counts:</strong> car-related crime only, from two separate sources.
        <strong>MPD data</strong> covers four offense types: theft from a motor vehicle, motor vehicle theft, theft of vehicle parts, and property damage/vandalism.
        <strong>Resident reports</strong> come from people who submit a break-in on this site. Each number below says which source it uses.
        <a href="#what-these-numbers-mean">Full definitions</a>
    </p>

    <h2 class="stat-group-heading">Car-related crime, last 30 days (MPD data)</h2>
    <div class="stat-line">
        <div class="stat">
            <div class="stat-value">@stats.Count.Format()</div>
            <div class="stat-label">car-related offenses recorded by MPD in the last 30 days (through @ytdThrough)</div>
        </div>
        <div class="stat">
            <div class="stat-value @changeClass">@changeText</div>
            <div class="stat-label">change in MPD car-related offenses vs. the 30 days before that</div>
        </div>
        @if (gap.PercentUnreported is not null)
        {
            <div class="stat">
                <div class="stat-value up">@(gap.PercentUnreported)%</div>
                <div class="stat-label">of residents who reported a car break-in on this site (@gap.RespondedCount.Format() answered) said they never told police. This one figure comes from resident reports, not MPD.</div>
            </div>
        }
    </div>

    <h2 class="stat-group-heading">Car-related crime, so far in @ytd.CurrentYear (MPD data)</h2>
    <div class="stat-line stat-line-year">
        <div class="stat">
            <div class="stat-value">@ytdNow.Format()</div>
            <div class="stat-label">car-related offenses recorded by MPD, Jan 1 to @ytdThrough @ytd.CurrentYear</div>
        </div>
        <div class="stat">
            <div class="stat-value @PctClass(ytdNow, ytdPrior)">@Pct(ytdNow, ytdPrior)</div>
            <div class="stat-label">change in MPD car-related offenses vs. Jan 1 to @ytdThrough @(ytd.CurrentYear - 1)</div>
        </div>
        <div class="stat">
            <div class="stat-value @PctClass(ytdNow, ytdBase)">@Pct(ytdNow, ytdBase)</div>
            <div class="stat-label">change in MPD car-related offenses vs. Jan 1 to @ytdThrough @ytd.Years[0], the last year before COVID</div>
        </div>
    </div>
    <p class="field-hint stat-line-note">
        Every count of offenses on this page is MPD data. Resident reports@(Model.ResidentReportsLast30Days > 0 ? $" ({Model.ResidentReportsLast30Days.Format()} in the last 30 days)" : "") are shown as separate dots on the map and are never added to these
        numbers, because a resident who also called the police would otherwise be counted twice. Resident reports are unverified.
    </p>
    <p class="field-hint stat-line-note">
        MPD data through @ytdThrough. MPD posts the most recent days late, so the newest 10 days are held back until they fill in. 2019 is the first year of MPD's
        current records feed and runs low early in the year, so read that comparison with care.
        <a asp-controller="Trends" asp-action="Index">See the full trends &rarr;</a>
    </p>

    <p>
        <a class="btn" asp-controller="Report" asp-action="Index">Report a break-in</a>
        &nbsp;
        <a class="btn btn-outline" asp-controller="Map" asp-action="Index">View the map</a>
        &nbsp;
        <a class="btn btn-outline" asp-controller="Trends" asp-action="Index">Explore the trends</a>
    </p>

    <div class="map-frame map-frame-preview">
        <a class="map-frame-link" asp-controller="Map" asp-action="Index" aria-label="Open the full interactive map"></a>
        <div id="home-map"></div>
    </div>
    <div class="map-preview-caption">
        <span>Each circle is one block with car-related offenses recorded by MPD in the week ending @ytdThrough. Resident reports appear as separate dots. Click the map to explore it, including all-crime views.</span>
        <a asp-controller="Map" asp-action="Index">Open the full map &rarr;</a>
    </div>
    @if (Model.MpdLastSyncedAt is { } lastSyncedAt)
    {
        <p class="field-hint" style="margin-top: 0.4rem;">MPD data last synced @lastSyncedAt.FormatSyncTimestamp().</p>
    }

    <div class="graphs-grid">
        <div>
            <h2 class="graph-heading">Car-related offenses by month (MPD data)</h2>
            <p class="field-hint">Theft from vehicles, vehicle theft, parts theft and property damage/vandalism combined. Complete months only.</p>
            @if (Model.Trend.Count == 0)
            {
                <p class="field-hint">Not enough data yet.</p>
            }
            else
            {
                <div class="trend-chart" role="img" aria-label="Car-related offenses per month for the last six months">
                    @foreach (var m in Model.Trend)
                    {
                        <div class="trend-bar-col">
                            <div class="trend-bar-track">
                                <div class="trend-bar" style="height:@((m.Count * 100.0 / maxTrend).ToString("0.##"))%"></div>
                            </div>
                            <div class="trend-bar-count">@m.Count.Format()</div>
                            <div class="trend-bar-label">@m.MonthLabel</div>
                        </div>
                    }
                </div>
            }
        </div>
        <div>
            <h2 class="graph-heading">So far in @ytd.CurrentYear, by car-related offense type</h2>
            <p class="field-hint">MPD offenses, Jan 1 to @ytdThrough, then resident reports below the line.</p>
            @if (categoryByKey.Count == 0)
            {
                <p class="field-hint">Not enough data yet.</p>
            }
            else
            {
                <div class="category-list">
                    @foreach (var key in categoryOrder.Where(k => categoryByKey.ContainsKey(k)))
                    {
                        // A labeled break before the resident rows: they are a separate source, not part of the MPD counts above.
                        @if (key == "WindowSmashed" || (key == "Rifled" && !categoryByKey.ContainsKey("WindowSmashed")))
                        {
                            <div class="category-divider">Resident reports (unverified, not police data, not included in the MPD numbers above)</div>
                        }
                        <div class="breakdown-row">
                            <span class="breakdown-label">@categoryLabel[key]</span>
                            <span class="breakdown-bar-track"><span class="breakdown-bar @categoryCssClass[key]" style="width:@((categoryByKey[key] * 100.0 / maxCategory).ToString("0.##"))%"></span></span>
                            <span class="breakdown-count">@categoryByKey[key].Format()</span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="graphs-grid graphs-grid-even">
        <div>
            <h2 class="graph-heading">Neighborhoods with the most car-related offenses in @ytd.CurrentYear (MPD data)</h2>
            <ol class="home-areas">
                @foreach (var (area, i) in ytd.Neighborhoods.Take(5).Select((a, i) => (a, i)))
                {
                    <li>
                        <span class="home-area-rank">@(i + 1)</span>
                        <a href="@area.Url">@area.Name</a>
                        <strong>@area.Counts[^1].Format()</strong>
                        <span class="home-area-change @(area.ChangeVsPrior is > 0 ? "up" : area.ChangeVsPrior is < 0 ? "down" : "")">@(area.ChangeVsPrior is { } c ? $"{(c >= 0 ? "+" : "-")}{Math.Abs(Math.Round(c)).ToString("0", System.Globalization.CultureInfo.InvariantCulture)}%" : "")</span>
                    </li>
                }
            </ol>
            <a class="home-areas-more" asp-controller="Areas" asp-action="Index">All neighborhoods and wards &rarr;</a>
        </div>
        <div>
            <h2 class="graph-heading">Wards with the most car-related offenses in @ytd.CurrentYear (MPD data)</h2>
            <ol class="home-areas">
                @foreach (var (area, i) in ytd.Wards.Take(5).Select((a, i) => (a, i)))
                {
                    <li>
                        <span class="home-area-rank">@(i + 1)</span>
                        <a href="@area.Url">@area.Name</a>
                        <strong>@area.Counts[^1].Format()</strong>
                        <span class="home-area-change @(area.ChangeVsPrior is > 0 ? "up" : area.ChangeVsPrior is < 0 ? "down" : "")">@(area.ChangeVsPrior is { } c ? $"{(c >= 0 ? "+" : "-")}{Math.Abs(Math.Round(c)).ToString("0", System.Globalization.CultureInfo.InvariantCulture)}%" : "")</span>
                    </li>
                }
            </ol>
            <p class="field-hint">Car-related offenses recorded by MPD, Jan 1 to @ytdThrough, with the change from the same dates in @(ytd.CurrentYear - 1). Raw counts mostly reflect where people live, work and park, so this is not a ranking of safety.</p>
        </div>
    </div>

    </section>

    <h2 class="graph-heading" style="margin-top: 3rem;">Explore the data</h2>
    <p class="field-hint">Cards marked "all crimes" cover every offense type MPD records. Cards marked "car-related" cover only the four car categories.</p>
    <div class="explore-grid">
        <a class="explore-card" asp-controller="Crime" asp-action="Index">
            <strong>Crime statistics (all crimes)</strong>
            <span>Every offense type MPD records, 2019 to today, by type, neighborhood and hour of day.</span>
        </a>
        <a class="explore-card" asp-controller="Near" asp-action="Index">
            <strong>Crime near you (all crimes)</strong>
            <span>Enter an address to see every offense type MPD recorded within a quarter mile to a mile.</span>
        </a>
        <a class="explore-card" asp-controller="Monthly" asp-action="Index">
            <strong>Monthly reports (all crimes)</strong>
            <span>A sourced summary of every finished month, covering every offense type, with a permanent link and an RSS feed.</span>
        </a>
        <a class="explore-card" asp-controller="Compare" asp-action="Index">
            <strong>Compare areas (all crimes or car-related)</strong>
            <span>Put neighborhoods or wards side by side, as counts or per 1,000 residents.</span>
        </a>
        <a class="explore-card" asp-controller="Trends" asp-action="Index">
            <strong>Car crime trends (car-related, MPD data)</strong>
            <span>Theft from vehicles, vehicle theft, parts theft and property damage, year over year.</span>
        </a>
        <a class="explore-card" asp-controller="Data" asp-action="Index">
            <strong>Downloads and methodology</strong>
            <span>CSV files, a JSON API, and exactly how the numbers are built.</span>
        </a>
    </div>

</div>

<div class="breakout city-comparison-section">
    <div class="city-comparison-inner">
        <h2 class="graph-heading" style="margin-bottom: 0.25rem;">Car-related offenses by year since 2019 (MPD data)</h2>
        <p class="field-hint" style="max-width: 640px; margin-bottom: 1.5rem;">
            One chart for each of three car-related MPD offense types, counted per year. These are police records only.
            Resident reports are not included. The line for the current year is a projection, explained below.
        </p>

        <div class="city-charts-grid">
        @foreach (var series in yearlyCharts)
        {
            var counts = series.Counts;
            var n = counts.Count;
            var last = counts[^1];
            var hasProjection = last.ProjectedCount is not null;
            var yMax = NiceMax(n > 0 ? counts.Max(c => c.ProjectedCount ?? c.Count) : 0);
            var gridStep = Math.Max(1, yMax / 4);
            var solidCount = hasProjection ? n - 1 : n;
            var solidPoints = string.Join(" ", Enumerable.Range(0, solidCount)
                .Select(i => $"{F(PlotX(n, i))},{F(PlotY(counts[i].Count, yMax))}"));
            var colWidth = (chartW - marginLeft - marginRight) / (double)(n - 1);
            var chartBottom = chartH - marginBottom;

            <div class="city-chart">
                <h3 class="city-chart-title"><a href="/trends?category=@series.Slug">@series.Title</a></h3>
                <svg viewBox="0 0 @chartW @chartH" class="city-chart-svg" role="group" aria-label="@series.Title, Minneapolis, 2019 to today">
                    @for (var g = 0; g <= yMax; g += gridStep)
                    {
                        var gy = PlotY(g, yMax);
                        <line x1="@marginLeft" y1="@F(gy)" x2="@(chartW - marginRight)" y2="@F(gy)" class="city-chart-gridline" />
                        @Html.Raw($"<text x=\"{marginLeft - 8}\" y=\"{F(gy + 4)}\" class=\"city-chart-axis-label\" text-anchor=\"end\">{g.Format()}</text>")
                    }
                    @for (var i = 0; i < n; i++)
                    {
                        var isProjectedYear = i == n - 1 && hasProjection;
                        var axisLabel = isProjectedYear ? $"{counts[i].Year}*" : counts[i].Year.ToString();
                        @Html.Raw($"<text x=\"{F(PlotX(n, i))}\" y=\"{chartH - 6}\" class=\"city-chart-axis-label\" text-anchor=\"middle\">{axisLabel}</text>")
                    }
                    <polyline points="@solidPoints" class="city-chart-line minneapolis" />
                    @if (hasProjection)
                    {
                        <line x1="@F(PlotX(n, n - 2))" y1="@F(PlotY(counts[n - 2].Count, yMax))"
                              x2="@F(PlotX(n, n - 1))" y2="@F(PlotY(last.ProjectedCount!.Value, yMax))"
                              class="city-chart-line-projected minneapolis" />
                        <line x1="@F(PlotX(n, n - 1))" y1="@F(PlotY(last.Count, yMax))"
                              x2="@F(PlotX(n, n - 1))" y2="@F(PlotY(last.ProjectedCount!.Value, yMax))"
                              class="city-chart-line-gap" />
                    }
                    @for (var i = 0; i < n; i++)
                    {
                        var c = counts[i];
                        var x = PlotX(n, i);
                        var isProjectedYear = i == n - 1 && hasProjection;
                        var asOf = c.AsOf?.ToString("MMM d", System.Globalization.CultureInfo.InvariantCulture);
                        var tipTitle = isProjectedYear ? $"{c.Year} (projected)" : c.Year.ToString();
                        var tipValue = isProjectedYear ? $"~{c.ProjectedCount!.Value.Format()} reports" : $"{c.Count.Format()} reports";
                        var tipDetail = isProjectedYear
                            ? $"{c.Count.Format()} so far through {asOf}. Projected from how much of the year was done by this date in earlier years."
                            : c.AsOf is not null ? $"{c.Count.Format()} so far through {asOf}" : "";
                        var hitLeft = Math.Max(0, x - colWidth / 2);
                        var hitRight = Math.Min(chartW, x + colWidth / 2);
                        var anchorY = PlotY(isProjectedYear ? c.ProjectedCount!.Value : c.Count, yMax);

                        <g class="city-chart-year" tabindex="0" role="img"
                           aria-label="@tipTitle: @tipValue. @tipDetail"
                           data-tip-title="@tipTitle" data-tip-value="@tipValue" data-tip-detail="@tipDetail"
                           data-anchor-x="@F(x)" data-anchor-y="@F(anchorY)">
                            <rect class="city-chart-hit" x="@F(hitLeft)" y="0" width="@F(hitRight - hitLeft)" height="@chartBottom" />
                            <line class="city-chart-guide" x1="@F(x)" y1="@marginTop" x2="@F(x)" y2="@chartBottom" />
                            @if (isProjectedYear)
                            {
                                <circle cx="@F(x)" cy="@F(PlotY(c.Count, yMax))" r="3.5" class="city-chart-dot minneapolis" />
                                <circle cx="@F(x)" cy="@F(anchorY)" r="4.5" class="city-chart-dot-projected minneapolis" />
                            }
                            else
                            {
                                <circle cx="@F(x)" cy="@F(anchorY)" r="3.5" class="city-chart-dot minneapolis" />
                            }
                        </g>
                    }
                    @{
                        var endPoint = (X: PlotX(n, n - 1), Y: PlotY(hasProjection ? last.ProjectedCount!.Value : last.Count, yMax));
                        var endText = hasProjection ? $"~{last.ProjectedCount!.Value.Format()}" : last.Count.Format();
                    }
                    @Html.Raw($"<text x=\"{F(endPoint.X + 10)}\" y=\"{F(endPoint.Y + 4)}\" class=\"city-chart-end-label minneapolis\">{endText}</text>")
                </svg>
            </div>
        }
        </div>

        <p class="field-hint" style="margin-top: 1.5rem;">
            Source: this site's import of Minneapolis Police Department open data. The current
            year (*) is projected: the year-to-date count divided by the share of the year's total
            that was already recorded by this date in 2019 through last year. The dashed line and
            hollow marker are the projection, the solid dot is the actual count so far. Hover or
            tap a year for exact numbers. "Destruction/damage/
            vandalism of property" is MPD's own category name and isn't vehicle-specific -- see
            <a asp-controller="Map" asp-action="Index">the map</a> for details.
            <a asp-controller="Trends" asp-action="Index">Compare every year, month and neighborhood in Trends &rarr;</a>
        </p>
    </div>
</div>

<div class="page">
    <h2 id="what-these-numbers-mean" style="margin-top: 1rem; font-size: 1.4rem;">What these numbers mean</h2>
    <ul class="definitions">
        <li><strong>MPD data.</strong> Records the Minneapolis Police Department publishes on the city's open data portal. This site imports them daily. Only crimes reported to police are in it.</li>
        <li><strong>Resident reports.</strong> Car break-ins that people submit on this site. They are unverified, and some may also be in MPD's data (someone who also called the police). The two can't be matched, so resident reports are never added to any MPD count, percentage or chart.</li>
        <li><strong>Car-related.</strong> Four MPD offense types combined: theft from motor vehicle (a break-in or items taken from a car), motor vehicle theft (the whole car), theft of motor vehicle parts or accessories (catalytic converters, wheels), and destruction/damage/vandalism of property. That last type covers all property, such as graffiti and broken windows on buildings, and is not limited to cars.</li>
        <li><strong>All crimes.</strong> Every offense type MPD records, from homicide to shoplifting. Part 1 of this page shows these. Car-related crime is a subset of them, so Part 2's MPD numbers are already inside Part 1's totals. Don't add the two together.</li>
        <li><strong>Offense.</strong> One count of one crime type. A case with two victims is two offenses. Pages that count this way agree with each other.</li>
        <li><strong>Why the newest 10 days are missing.</strong> MPD posts records days late. Counting them early would make the latest days look quiet, so every figure stops about ten days before today (currently @ytdThrough).</li>
        <li><strong>Percent changes.</strong> Always the same calendar dates in each year, never a partial year against a full one.</li>
    </ul>

    <h2 style="margin-top: 2.5rem; font-size: 1.4rem;">Why this exists</h2>
    <p>
        Police don't track this the way we need them to. Their data has a
        category for a car getting broken into, "Theft From Motor
        Vehicle," but it doesn't say how someone got in -- a smashed
        window and someone rifling through your glovebox get lumped into
        the same record. There's no field for what actually happened.
    </p>
    <p>
        Most people don't report it either. When a window gets smashed and nothing is missing what are the police going to
        do about it? A police report is never created and neither is that data point. Multiply that by every car on
        your block and there's no record of any of it anywhere.
    </p>
    <p>
        This site fixes both problems. Report a window getting smashed
        or a car getting rifled through, block by block, date by date.
        Right now the map is mostly MPD's own numbers -- car break-ins,
        parts theft, and full vehicle theft -- since that's what exists
        until enough of you report your own. After a while we can go to
        police and city hall with specifics about what's going on: which
        blocks, which times, how often.
    </p>

    <h2 style="margin-top: 2.5rem; font-size: 1.4rem;">Your privacy</h2>
    <p>
        Locations shown on the map are snapped to the middle of the block and never the exact
        address. This is how the MPD saves their data and so do we. It's all in the name of privacy.
        After you submit a report we also point you to
        Minneapolis Police Department's online reporting, since this site is
        meant to complement official channels, not replace them.
    </p>
</div>

